<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Sujud Master - PAI Kelas 7 Interactive Game</title>
    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- FontAwesome Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <!-- Google Fonts -->
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;600;700;800&family=Amiri:wght@400;700&display=swap" rel="stylesheet">
    <!-- Canvas Confetti for rewards -->
    <script src="https://cdn.jsdelivr.net/npm/canvas-confetti@1.6.0/dist/confetti.browser.min.js"></script>

    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        emeraldCustom: '#059669',
                        tealCustom: '#0d9488',
                        goldCustom: '#f59e0b',
                        softBackground: '#f0fdf4'
                    },
                    fontFamily: {
                        sans: ['Poppins', 'sans-serif'],
                        arabic: ['Amiri', 'serif']
                    }
                }
            }
        }
    </script>

    <style>
        body {
            background-color: #f0fdf4;
            font-family: 'Poppins', sans-serif;
            user-select: none;
        }
        .arabic-text {
            font-family: 'Amiri', serif;
            direction: rtl;
        }
        .tab-btn.active {
            background-color: #059669;
            color: white;
            box-shadow: 0 4px 14px rgba(5, 150, 105, 0.4);
        }
        .animate-bounce-short {
            animation: bounce 0.8s ease-in-out 1;
        }
        @keyframes bounce {
            0%, 100% { transform: translateY(0); }
            50% { transform: translateY(-10px); }
        }
        .gradient-card {
            background: linear-gradient(135deg, #ffffff 0%, #f0fdf4 100%);
        }
    </style>
</head>
<body class="min-h-screen text-slate-800 flex flex-col justify-between">

    <!-- Header / Navbar -->
    <header class="bg-emerald-700 text-white shadow-lg sticky top-0 z-50">
        <div class="max-w-6xl mx-auto px-4 py-3 flex flex-wrap justify-between items-center">
            <div class="flex items-center space-x-3">
                <div class="bg-amber-400 p-2.5 rounded-2xl text-emerald-900 font-extrabold text-xl shadow-md">
                    <i class="fa-solid fa-hands-praying"></i>
                </div>
                <div>
                    <h1 class="text-lg md:text-xl font-bold tracking-wide">Sujud Master <span class="text-amber-300 text-xs md:text-sm font-normal">| Islamic Learning</span></h1>
                    <p class="text-xs text-emerald-100">PAI Grade 7 • Guru: Devy Eka Angelica, M. Pd</p>
                </div>
            </div>

            <!-- Score & Sound Control -->
            <div class="flex items-center space-x-3 mt-2 md:mt-0">
                <div class="bg-emerald-800/80 border border-emerald-500/50 px-3 py-1.5 rounded-full flex items-center space-x-2 text-sm font-semibold">
                    <i class="fa-solid fa-star text-amber-300 animate-pulse"></i>
                    <span>Score: <span id="userScore" class="text-amber-300">0</span> XP</span>
                </div>
                <button id="soundToggleBtn" onclick="toggleAudio()" class="bg-emerald-800 hover:bg-emerald-600 p-2 rounded-full text-white transition text-sm w-9 h-9 flex items-center justify-center">
                    <i class="fa-solid fa-volume-high" id="soundIcon"></i>
                </button>
            </div>
        </div>
    </header>

    <!-- Main Content Area -->
    <main class="max-w-6xl mx-auto px-4 py-6 flex-grow w-full">
        
        <!-- Welcome Greeting Banner -->
        <div class="bg-gradient-to-r from-emerald-600 to-teal-600 rounded-3xl p-6 text-white shadow-xl mb-6 relative overflow-hidden flex flex-col md:flex-row items-center justify-between gap-6">
            <div class="absolute -right-6 -bottom-6 opacity-10 text-9xl">
                <i class="fa-solid fa-mosque"></i>
            </div>
            <div class="relative z-10 max-w-xl">
                <span class="bg-amber-400 text-emerald-950 text-xs font-extrabold uppercase px-3 py-1 rounded-full shadow-sm">
                    ✨ Welcome Champions!
                </span>
                <h2 class="text-2xl md:text-3xl font-extrabold mt-2">Assalamu'alaikum, Young Muslim Leader! 👋</h2>
                <p class="text-emerald-100 text-sm mt-1 leading-relaxed">
                    Mari belajar <span class="font-semibold text-amber-200">3 Jenis Sujud</span> (Syukur, Sahwi, & Tilawah) bersama Ibu Guru dengan cara yang menyenangkan! Choose a topic below to start your adventure.
                </p>
            </div>

            <!-- Teacher Profile Card -->
            <div class="relative z-10 bg-white/10 backdrop-blur-md border border-white/20 p-3.5 rounded-2xl flex items-center gap-3.5 min-w-[260px] shadow-lg">
                <div class="relative group cursor-pointer" onclick="document.getElementById('teacherPhotoInput').click()" title="Klik untuk mengunggah / mengganti foto Ibu Guru">
                    <img id="teacherAvatar" src="bg putih_2.jpg" onerror="this.onerror=null; this.src='bg putih.jpg';" alt="Devy Eka Angelica, M. Pd" class="w-16 h-16 rounded-2xl object-cover border-2 border-amber-300 shadow-md">
                    <span class="absolute -bottom-1 -right-1 bg-emerald-500 text-white text-[10px] p-1 rounded-full border border-white" title="Verified Teacher"><i class="fa-solid fa-circle-check"></i></span>
                    <div class="absolute inset-0 bg-black/40 rounded-2xl opacity-0 group-hover:opacity-100 transition flex items-center justify-center text-white text-xs">
                        <i class="fa-solid fa-camera"></i>
                    </div>
                </div>
                <input type="file" id="teacherPhotoInput" accept="image/*" class="hidden" onchange="uploadTeacherPhoto(event)">
                <div>
                    <span class="bg-amber-300/30 text-amber-200 text-[10px] font-bold px-2 py-0.5 rounded-md uppercase tracking-wider">Guru Pengampu</span>
                    <h3 class="text-sm font-bold text-white mt-0.5">Devy Eka Angelica, M. Pd</h3>
                    <p class="text-[11px] text-emerald-100">Guru PAI Grade 7 SMP</p>
                    <button onclick="document.getElementById('teacherPhotoInput').click()" class="text-[10px] text-amber-300 hover:text-amber-200 hover:underline mt-1 flex items-center gap-1 font-semibold">
                        <i class="fa-solid fa-camera"></i> Upload Foto Saya
                    </button>
                </div>
            </div>
        </div>

        <!-- Navigation Tabs -->
        <nav class="flex flex-wrap gap-2 justify-center mb-6 bg-white p-2 rounded-2xl shadow-sm border border-emerald-100">
            <button onclick="switchTab('learnTab')" id="btn-learnTab" class="tab-btn active px-4 py-2.5 rounded-xl text-sm font-semibold transition flex items-center gap-2">
                <i class="fa-solid fa-book-open"></i>
                <span>1. Learn & Compare <br><span class="text-[10px] opacity-80">(Materi & Tabel)</span></span>
            </button>
            <button onclick="switchTab('simTab')" id="btn-simTab" class="tab-btn bg-slate-100 text-slate-600 hover:bg-slate-200 px-4 py-2.5 rounded-xl text-sm font-semibold transition flex items-center gap-2">
                <i class="fa-solid fa-person-praying"></i>
                <span>2. Sujud Practice <br><span class="text-[10px] opacity-80">(Simulasi Latihan)</span></span>
            </button>
            <button onclick="switchTab('matchTab')" id="btn-matchTab" class="tab-btn bg-slate-100 text-slate-600 hover:bg-slate-200 px-4 py-2.5 rounded-xl text-sm font-semibold transition flex items-center gap-2">
                <i class="fa-solid fa-puzzle-piece"></i>
                <span>3. Case Matcher <br><span class="text-[10px] opacity-80">(Game Cari Pasangan)</span></span>
            </button>
            <button onclick="switchTab('quizTab')" id="btn-quizTab" class="tab-btn bg-slate-100 text-slate-600 hover:bg-slate-200 px-4 py-2.5 rounded-xl text-sm font-semibold transition flex items-center gap-2">
                <i class="fa-solid fa-trophy"></i>
                <span>4. Quiz Master <br><span class="text-[10px] opacity-80">(Kuis Interaktif)</span></span>
            </button>
        </nav>

        <!-- TAB 1: LEARN & COMPARE -->
        <section id="learnTab" class="space-y-8 tab-content">
            <!-- 3 Sujud Cards Grid -->
            <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
                
                <!-- Card 1: Sujud Syukur -->
                <div class="bg-white rounded-3xl p-5 border-2 border-emerald-100 hover:border-emerald-400 shadow-md transition transform hover:-translate-y-1 flex flex-col justify-between">
                    <div>
                        <div class="flex justify-between items-start mb-3">
                            <span class="bg-emerald-100 text-emerald-800 text-xs font-bold px-3 py-1 rounded-full">1. Gratitude</span>
                            <span class="text-emerald-600 text-xl"><i class="fa-solid fa-heart"></i></span>
                        </div>
                        <h3 class="text-xl font-bold text-emerald-900">Sujud Syukur</h3>
                        <p class="text-xs text-slate-500 font-medium mb-3">Prostration of Gratitude</p>
                        
                        <div class="bg-slate-50 p-3 rounded-2xl border border-slate-100 mb-3 space-y-2 text-xs">
                            <p><strong class="text-emerald-700">💡 Alasan (Why):</strong> Ketika mendapat nikmat besar atau terhindar dari bahaya / <em>Receiving great blessings or saved from danger.</em></p>
                            <p><strong class="text-emerald-700">📍 Tempat (Where):</strong> Di luar Shalat / <em>Outside Prayer.</em></p>
                            <p><strong class="text-emerald-700">🔢 Jumlah:</strong> 1 kali sujud / <em>1 Prostration.</em></p>
                        </div>

                        <div class="bg-emerald-50 p-3 rounded-2xl border border-emerald-100 text-center">
                            <p class="text-xs text-emerald-800 font-semibold mb-1">Bacaan / Recitation:</p>
                            <p class="arabic-text text-lg text-emerald-950 my-1 font-bold">سَجَدَ وَجْهِيَ لِلَّذِي خَلَقَهُ وَصَوَّرَهُ</p>
                            <p class="text-[11px] text-slate-600 italic">"Sajada wajhiya lilladzi khalaqahu wa sawwarahu..."</p>
                        </div>
                    </div>
                    <button onclick="openDetailModal('syukur')" class="mt-4 w-full bg-emerald-600 hover:bg-emerald-700 text-white text-xs font-bold py-2.5 rounded-xl transition flex items-center justify-center gap-2 shadow-sm">
                        <i class="fa-solid fa-circle-info"></i> Tata Cara Lengkap
                    </button>
                </div>

                <!-- Card 2: Sujud Sahwi -->
                <div class="bg-white rounded-3xl p-5 border-2 border-amber-100 hover:border-amber-400 shadow-md transition transform hover:-translate-y-1 flex flex-col justify-between">
                    <div>
                        <div class="flex justify-between items-start mb-3">
                            <span class="bg-amber-100 text-amber-800 text-xs font-bold px-3 py-1 rounded-full">2. Forgetfulness</span>
                            <span class="text-amber-600 text-xl"><i class="fa-solid fa-brain"></i></span>
                        </div>
                        <h3 class="text-xl font-bold text-amber-900">Sujud Sahwi</h3>
                        <p class="text-xs text-slate-500 font-medium mb-3">Prostration of Forgetfulness</p>
                        
                        <div class="bg-slate-50 p-3 rounded-2xl border border-slate-100 mb-3 space-y-2 text-xs">
                            <p><strong class="text-amber-700">💡 Alasan (Why):</strong> Lupa/ragu rakaat shalat atau lupa Tasyahud Awal / <em>Forgetfulness or doubt in prayer.</em></p>
                            <p><strong class="text-amber-700">📍 Tempat (Where):</strong> Di akhir shalat (sebelum/sesudah salam) / <em>At the end of prayer.</em></p>
                            <p><strong class="text-amber-700">🔢 Jumlah:</strong> 2 kali sujud / <em>2 Prostrations.</em></p>
                        </div>

                        <div class="bg-amber-50 p-3 rounded-2xl border border-amber-100 text-center">
                            <p class="text-xs text-amber-800 font-semibold mb-1">Bacaan / Recitation:</p>
                            <p class="arabic-text text-lg text-amber-950 my-1 font-bold">سُبْحَانَ مَنْ لَا يَنَامُ وَلَا يَسْهُو</p>
                            <p class="text-[11px] text-slate-600 italic">"Subhana man la yanamu wa la yashu."</p>
                        </div>
                    </div>
                    <button onclick="openDetailModal('sahwi')" class="mt-4 w-full bg-amber-500 hover:bg-amber-600 text-white text-xs font-bold py-2.5 rounded-xl transition flex items-center justify-center gap-2 shadow-sm">
                        <i class="fa-solid fa-circle-info"></i> Tata Cara Lengkap
                    </button>
                </div>

                <!-- Card 3: Sujud Tilawah -->
                <div class="bg-white rounded-3xl p-5 border-2 border-teal-100 hover:border-teal-400 shadow-md transition transform hover:-translate-y-1 flex flex-col justify-between">
                    <div>
                        <div class="flex justify-between items-start mb-3">
                            <span class="bg-teal-100 text-teal-800 text-xs font-bold px-3 py-1 rounded-full">3. Recitation</span>
                            <span class="text-teal-600 text-xl"><i class="fa-solid fa-book-quran"></i></span>
                        </div>
                        <h3 class="text-xl font-bold text-teal-900">Sujud Tilawah</h3>
                        <p class="text-xs text-slate-500 font-medium mb-3">Prostration of Qur'an Recitation</p>
                        
                        <div class="bg-slate-50 p-3 rounded-2xl border border-slate-100 mb-3 space-y-2 text-xs">
                            <p><strong class="text-teal-700">💡 Alasan (Why):</strong> Membaca atau mendengar Ayat Sajdah (🔍 tanda ۩) / <em>Reading or hearing a Sajdah verse.</em></p>
                            <p><strong class="text-teal-700">📍 Tempat (Where):</strong> Dalam shalat atau Luar shalat / <em>Inside or outside prayer.</em></p>
                            <p><strong class="text-teal-700">🔢 Jumlah:</strong> 1 kali sujud / <em>1 Prostration.</em></p>
                        </div>

                        <div class="bg-teal-50 p-3 rounded-2xl border border-teal-100 text-center">
                            <p class="text-xs text-teal-800 font-semibold mb-1">Bacaan / Recitation:</p>
                            <p class="arabic-text text-lg text-teal-950 my-1 font-bold">سَجَدَ وَجْهِيَ لِلَّذِي خَلَقَهُ وَشَقَّ سَمْعَهُ وَبَصَرَهُ</p>
                            <p class="text-[11px] text-slate-600 italic">"Sajada wajhiya lilladzi khalaqahu wa shaqqa sam'ahu..."</p>
                        </div>
                    </div>
                    <button onclick="openDetailModal('tilawah')" class="mt-4 w-full bg-teal-600 hover:bg-teal-700 text-white text-xs font-bold py-2.5 rounded-xl transition flex items-center justify-center gap-2 shadow-sm">
                        <i class="fa-solid fa-circle-info"></i> Tata Cara Lengkap
                    </button>
                </div>

            </div>

            <!-- Comparison Table Section -->
            <div class="bg-white rounded-3xl p-6 shadow-md border border-emerald-100">
                <div class="flex items-center space-x-3 mb-4">
                    <div class="bg-emerald-100 p-2.5 rounded-xl text-emerald-700">
                        <i class="fa-solid fa-table-list text-xl"></i>
                    </div>
                    <div>
                        <h3 class="text-lg font-bold text-slate-800">📊 Tabel Perbandingan (Comparison Table)</h3>
                        <p class="text-xs text-slate-500">Ringkasan cepat untuk membedakan ketiga jenis sujud dengan mudah.</p>
                    </div>
                </div>

                <div class="overflow-x-auto">
                    <table class="w-full text-left text-xs text-slate-700 border-collapse">
                        <thead>
                            <tr class="bg-emerald-700 text-white rounded-t-xl">
                                <th class="p-3 rounded-tl-xl font-semibold">Poin Pembeda (Aspect)</th>
                                <th class="p-3 font-semibold">Sujud Syukur</th>
                                <th class="p-3 font-semibold">Sujud Sahwi</th>
                                <th class="p-3 rounded-tr-xl font-semibold">Sujud Tilawah</th>
                            </tr>
                        </thead>
                        <tbody class="divide-y divide-slate-100">
                            <tr class="hover:bg-slate-50 transition">
                                <td class="p-3 font-bold text-emerald-900 bg-emerald-50/50">Sebab Utama<br><span class="font-normal text-[10px] text-slate-500">(Reason)</span></td>
                                <td class="p-3">Dapat nikmat besar / Terhindar dari musibah</td>
                                <td class="p-3">Ragu/Lupa jumlah rakaat atau lupa Tasyahud Awal</td>
                                <td class="p-3">Membaca/mendengar Ayat Sajdah (ada simbol ۩)</td>
                            </tr>
                            <tr class="hover:bg-slate-50 transition">
                                <td class="p-3 font-bold text-emerald-900 bg-emerald-50/50">Waktu Pelaksanaan<br><span class="font-normal text-[10px] text-slate-500">(Timing)</span></td>
                                <td class="p-3"><span class="bg-red-100 text-red-700 px-2 py-0.5 rounded font-semibold">Luar Shalat Saja</span></td>
                                <td class="p-3"><span class="bg-blue-100 text-blue-700 px-2 py-0.5 rounded font-semibold">Dalam Shalat Saja</span> (Di akhir)</td>
                                <td class="p-3"><span class="bg-emerald-100 text-emerald-800 px-2 py-0.5 rounded font-semibold">Dalam ATAU Luar Shalat</span></td>
                            </tr>
                            <tr class="hover:bg-slate-50 transition">
                                <td class="p-3 font-bold text-emerald-900 bg-emerald-50/50">Jumlah Sujud<br><span class="font-normal text-[10px] text-slate-500">(Prostration Count)</span></td>
                                <td class="p-3 font-semibold text-emerald-700">1 Kali Sujud</td>
                                <td class="p-3 font-semibold text-amber-700">2 Kali Sujud</td>
                                <td class="p-3 font-semibold text-teal-700">1 Kali Sujud</td>
                            </tr>
                            <tr class="hover:bg-slate-50 transition">
                                <td class="p-3 font-bold text-emerald-900 bg-emerald-50/50">Syarat Suci<br><span class="font-normal text-[10px] text-slate-500">(Purity / Wudhu)</span></td>
                                <td class="p-3">Wajib Suci & Menutup Aurat</td>
                                <td class="p-3">Wajib Suci (Masih dalam shalat)</td>
                                <td class="p-3">Wajib Suci & Menutup Aurat</td>
                            </tr>
                            <tr class="hover:bg-slate-50 transition">
                                <td class="p-3 font-bold text-emerald-900 bg-emerald-50/50">Hukum<br><span class="font-normal text-[10px] text-slate-500">(Islamic Ruling)</span></td>
                                <td class="p-3"><span class="bg-emerald-100 text-emerald-800 px-2 py-0.5 rounded font-medium">Sunnah</span></td>
                                <td class="p-3"><span class="bg-emerald-100 text-emerald-800 px-2 py-0.5 rounded font-medium">Sunnah Muakkad</span></td>
                                <td class="p-3"><span class="bg-emerald-100 text-emerald-800 px-2 py-0.5 rounded font-medium">Sunnah</span></td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </section>

        <!-- TAB 2: SUJUD PRACTICE SIMULATOR -->
        <section id="simTab" class="space-y-6 tab-content hidden">
            <div class="bg-white rounded-3xl p-6 shadow-md border border-emerald-100 text-center max-w-3xl mx-auto">
                <span class="bg-emerald-100 text-emerald-800 text-xs font-extrabold uppercase px-3 py-1 rounded-full">
                    🧘 Interactive Practice / Simulasi Langkah
                </span>
                <h3 class="text-xl font-bold text-slate-800 mt-2">Pilih Skenario dan Lakukan Sujud yang Benar!</h3>
                <p class="text-xs text-slate-500 mb-6">Select a scenario below and follow the correct order of steps.</p>

                <!-- Scenario Selector Buttons -->
                <div class="grid grid-cols-1 md:grid-cols-3 gap-3 mb-6">
                    <button onclick="startSimulation('syukur')" id="sim-btn-syukur" class="p-3 rounded-2xl border-2 border-emerald-500 bg-emerald-50 hover:bg-emerald-100 font-bold text-xs text-emerald-900 transition flex items-center justify-center gap-2">
                        <i class="fa-solid fa-trophy text-amber-500"></i>
                        <span>Dapat Nilai 100 PAI!<br><span class="font-normal text-[10px]">(Sujud Syukur)</span></span>
                    </button>
                    <button onclick="startSimulation('sahwi')" id="sim-btn-sahwi" class="p-3 rounded-2xl border-2 border-slate-200 hover:bg-slate-50 font-bold text-xs text-slate-700 transition flex items-center justify-center gap-2">
                        <i class="fa-solid fa-triangle-exclamation text-amber-500"></i>
                        <span>Lupa Tasyahud Awal!<br><span class="font-normal text-[10px]">(Sujud Sahwi)</span></span>
                    </button>
                    <button onclick="startSimulation('tilawah')" id="sim-btn-tilawah" class="p-3 rounded-2xl border-2 border-slate-200 hover:bg-slate-50 font-bold text-xs text-slate-700 transition flex items-center justify-center gap-2">
                        <i class="fa-solid fa-book-open-reader text-emerald-500"></i>
                        <span>Dengar Ayat Sajdah ۩!<br><span class="font-normal text-[10px]">(Sujud Tilawah)</span></span>
                    </button>
                </div>

                <!-- Active Simulation Steps Display -->
                <div id="simDisplayArea" class="bg-gradient-to-br from-emerald-900 to-teal-900 rounded-3xl p-6 text-white min-h-[300px] flex flex-col justify-between shadow-inner relative overflow-hidden">
                    <div id="simStepHeader" class="flex justify-between items-center text-xs text-emerald-200 border-b border-emerald-700/60 pb-3">
                        <span>Step <span id="currentStepNum" class="font-bold text-amber-400">1</span> of <span id="totalStepNum">4</span></span>
                        <span id="simTypeTag" class="bg-emerald-700 px-3 py-1 rounded-full text-white font-semibold">Sujud Syukur</span>
                    </div>

                    <div class="my-6">
                        <div id="simStepIcon" class="text-5xl text-amber-300 mb-3 animate-bounce-short">
                            <i class="fa-solid fa-hands"></i>
                        </div>
                        <h4 id="simStepTitle" class="text-lg md:text-xl font-bold text-white mb-2">1. Niat & Takbiratul Ihram</h4>
                        <p id="simStepDesc" class="text-xs md:text-sm text-emerald-100 max-w-md mx-auto leading-relaxed">
                            Berdiri menghadap kiblat, berniat sujud syukur, dan mengucapkan Takbir ("Allahu Akbar").
                        </p>
                        
                        <!-- Arabic Recitation inside step if available -->
                        <div id="simArabicBox" class="mt-4 bg-emerald-800/60 border border-emerald-600/50 p-3 rounded-2xl hidden max-w-md mx-auto">
                            <p id="simArabicText" class="arabic-text text-xl text-amber-200 font-bold">سَجَدَ وَجْهِيَ لِلَّذِي خَلَقَهُ</p>
                            <p id="simLatinText" class="text-[11px] text-emerald-100 italic mt-1">"Sajada wajhiya lilladzi khalaqahu..."</p>
                        </div>
                    </div>

                    <!-- Step Controls -->
                    <div class="flex justify-between items-center pt-3 border-t border-emerald-700/60">
                        <button onclick="prevSimStep()" id="prevStepBtn" class="bg-emerald-800 hover:bg-emerald-700 text-white text-xs px-4 py-2 rounded-xl disabled:opacity-40 font-semibold" disabled>
                            <i class="fa-solid fa-arrow-left"></i> Previous
                        </button>
                        <div class="flex gap-1" id="simStepIndicators">
                            <!-- Dots generated by JS -->
                        </div>
