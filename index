            { id: 2, text: 'Ragu apakah sudah rakaat ke-3 atau ke-4 saat Shalat Dzuhur', target: 'sahwi' },
            { id: 3, text: 'Membaca Surah As-Sajdah ayat 15 yang memiliki simbol ۩', target: 'tilawah' },
            { id: 4, text: 'Lupa tidak melakukan Tasyahud Awal saat Shalat Isya', target: 'sahwi' }
        ];

        let selectedScenario = null;
        let matchedCount = 0;

        function initMatchGame() {
            matchedCount = 0;
            selectedScenario = null;
            const scenarioList = document.getElementById('scenarioList');
            const sujudOptionList = document.getElementById('sujudOptionList');

            scenarioList.innerHTML = matchScenarios.map(s => `
                <div id="scen-${s.id}" onclick="selectScenario(${s.id})" class="p-3 bg-slate-50 border-2 border-slate-200 rounded-2xl cursor-pointer hover:border-emerald-400 transition text-xs font-semibold text-slate-800 flex items-center justify-between">
                    <span>${s.text}</span>
                    <i class="fa-regular fa-circle text-slate-300 status-icon"></i>
                </div>
            `).join('');

            const sujudTypes = [
                { type: 'syukur', title: 'Sujud Syukur', sub: '(Gratitude)' },
                { type: 'sahwi', title: 'Sujud Sahwi', sub: '(Forgetfulness)' },
                { type: 'tilawah', title: 'Sujud Tilawah', sub: '(Recitation)' }
            ];

            sujudOptionList.innerHTML = sujudTypes.map(st => `
                <div onclick="selectSujudTarget('${st.type}')" class="p-3 bg-emerald-50 border-2 border-emerald-200 rounded-2xl cursor-pointer hover:bg-emerald-100 transition text-xs font-bold text-emerald-900 flex justify-between items-center">
                    <span>${st.title} <span class="font-normal text-[10px] text-emerald-700">${st.sub}</span></span>
                    <i class="fa-solid fa-arrow-right text-emerald-500"></i>
                </div>
            `).join('');
        }

        function selectScenario(id) {
            playSound('click');
            selectedScenario = matchScenarios.find(s => s.id === id);

            matchScenarios.forEach(s => {
                const el = document.getElementById('scen-' + s.id);
                if (s.id === id) {
                    el.className = 'p-3 bg-amber-50 border-2 border-amber-400 rounded-2xl cursor-pointer transition text-xs font-semibold text-amber-900 flex items-center justify-between shadow-sm';
                } else if (!el.classList.contains('bg-emerald-100')) {
                    el.className = 'p-3 bg-slate-50 border-2 border-slate-200 rounded-2xl cursor-pointer hover:border-emerald-400 transition text-xs font-semibold text-slate-800 flex items-center justify-between';
                }
            });

            const fb = document.getElementById('matchFeedback');
            fb.classList.remove('hidden');
            document.getElementById('matchFeedbackText').innerText = `Terpilih: "${selectedScenario.text}". Sekarang pilih Jenis Sujud di kanan!`;
        }

        function selectSujudTarget(targetType) {
            if (!selectedScenario) {
                playSound('wrong');
                alert('Pilih skenario di sebelah kiri terlebih dahulu!');
                return;
            }

            const scenEl = document.getElementById('scen-' + selectedScenario.id);

            if (selectedScenario.target === targetType) {
                playSound('correct');
                matchedCount++;
                addScore(25);

                scenEl.className = 'p-3 bg-emerald-100 border-2 border-emerald-500 rounded-2xl text-xs font-bold text-emerald-900 flex items-center justify-between pointer-events-none';
                scenEl.querySelector('.status-icon').className = 'fa-solid fa-circle-check text-emerald-600';

                document.getElementById('matchFeedbackText').innerText = `✅ Benar! "${selectedScenario.text}" adalah ${targetType.toUpperCase()}! (+25 XP)`;
                selectedScenario = null;

                if (matchedCount === matchScenarios.length) {
                    playSound('fanfare');
                    document.getElementById('matchFeedbackText').innerText = `🎉 Luar Biasa! Semua pasangan berhasil dicocokkan! (+100 XP Total)`;
                }
            } else {
                playSound('wrong');
                document.getElementById('matchFeedbackText').innerText = `❌ Kurang tepat, coba lagi ya! Pasangan untuk "${selectedScenario.text}" bukan itu.`;
            }
        }

        function resetMatchGame() {
            playSound('click');
            initMatchGame();
            document.getElementById('matchFeedback').classList.add('hidden');
        }

        const quizQuestions = [
            {
                q: 'Ahmad lupa melakukan Tasyahud Awal saat Shalat Dzuhur. Sebelum mengucap salam di akhir shalat, ia melakukan sujud 2 kali. Sujud apa ini?',
                qSub: 'Ahmad forgot the 1st Tasyahud in Dzuhur prayer and performed 2 prostrations before salam. What sujud is this?',
                options: ['Sujud Syukur', 'Sujud Sahwi', 'Sujud Tilawah', 'Sujud Rukun'],
                answer: 1
            },
            {
                q: 'Ketika membaca Al-Qur\'an, Siti menemukan simbol (۩) pada Surah Maryam ayat 58. Siti lalu bersujud 1 kali. Sujud apa yang dilakukan Siti?',
                qSub: 'Siti reads Quran and finds Sajdah symbol (۩). She prostrates once. What sujud is this?',
                options: ['Sujud Sahwi', 'Sujud Tilawah', 'Sujud Syukur', 'Sujud Sahat'],
                answer: 1
            },
            {
                q: 'Manakah jenis sujud yang HANYA boleh dilakukan di LUAR shalat?',
                qSub: 'Which prostration can ONLY be performed OUTSIDE of prayer?',
                options: ['Sujud Sahwi', 'Sujud Tilawah', 'Sujud Syukur', 'Semua Benar'],
                answer: 2
            },
            {
                q: 'Berapa kali jumlah sujud yang dilakukan saat Sujud Sahwi?',
                qSub: 'How many prostrations are performed in Sujud Sahwi?',
                options: ['1 Kali Sujud', '2 Kali Sujud', '3 Kali Sujud', '4 Kali Sujud'],
                answer: 1
            },
            {
                q: 'Apa bacaan utama ketika kita melakukan Sujud Sahwi?',
                qSub: 'What is the main recitation in Sujud Sahwi?',
                options: [
                    'سُبْحَانَ مَنْ لَا يَنَامُ وَلَا يَسْهُو',
                    'سُبْحَانَ رَبِّيَ الْأَعْلَى',
                    'الْحَمْدُ لِلَّهِ رَبِّ الْعَالَمِينَ',
                    'سُبْحَانَ رَبِّيَ الْعَظِيمِ'
                ],
                answer: 0
            }
        ];

        let currentQuizIndex = 0;
        let quizScore = 0;

        function loadQuizQuestion() {
            const q = quizQuestions[currentQuizIndex];
            document.getElementById('quizCurrentQ').innerText = currentQuizIndex + 1;
            document.getElementById('quizTotalQ').innerText = quizQuestions.length;
            document.getElementById('quizQuestionText').innerText = q.q;
            document.getElementById('quizQuestionSub').innerText = q.qSub;

            const optionsContainer = document.getElementById('quizOptionsList');
            optionsContainer.innerHTML = q.options.map((opt, idx) => `
                <button onclick="answerQuiz(${idx})" class="w-full text-left p-3.5 rounded-2xl border-2 border-slate-200 hover:border-emerald-500 hover:bg-emerald-50 transition font-semibold text-xs text-slate-800 flex items-center justify-between group">
                    <span><strong class="text-emerald-700 mr-2">${String.fromCharCode(65 + idx)}.</strong> ${opt}</span>
                    <i class="fa-solid fa-chevron-right text-slate-300 group-hover:text-emerald-600"></i>
                </button>
            `).join('');
        }

        function answerQuiz(optionIdx) {
            const q = quizQuestions[currentQuizIndex];
            if (optionIdx === q.answer) {
                playSound('correct');
                quizScore += 20;
                addScore(20);
            } else {
                playSound('wrong');
            }

            currentQuizIndex++;
            if (currentQuizIndex < quizQuestions.length) {
                loadQuizQuestion();
            } else {
                finishQuiz();
            }
        }

        function finishQuiz() {
            playSound('fanfare');
            document.getElementById('quizQuestionContainer').classList.add('hidden');
            document.getElementById('quizResultContainer').classList.remove('hidden');
            document.getElementById('finalQuizScore').innerText = quizScore + ' / 100 XP';
        }

        function restartQuiz() {
            playSound('click');
            currentQuizIndex = 0;
            quizScore = 0;
            document.getElementById('quizQuestionContainer').classList.remove('hidden');
            document.getElementById('quizResultContainer').classList.add('hidden');
            loadQuizQuestion();
        }

        function showCertificate() {
            playSound('click');
            document.getElementById('certModal').classList.remove('hidden');
        }

        function closeCertModal() {
            document.getElementById('certModal').classList.add('hidden');
        }

        window.onload = function() {
            // Load custom teacher photo if saved
            loadSavedTeacherPhoto();
            // Initialize Simulation
            startSimulation('syukur');
            // Initialize Match Game
            initMatchGame();
            // Initialize Quiz
            loadQuizQuestion();
        }
    </script>
</body>
</html>
